# 제조사 원문 문서는 저장소에 넣지 않는다.
# 근거: decision-log.md D-008 — 경로·SHA-256·출처 메타데이터만 보관하고
# 원본 바이너리는 재배포하지 않는다. 수집 대장(data/collected.json)에
# URL·해시·크기가 남아 있어 언제든 다시 내려받을 수 있다.
service-autopilot/pipeline/data/raw/
service-autopilot/evidence/ede-sample/

# 파이썬
__pycache__/
*.pyc
.venv/

# 검증·검토용 생성 HTML — 원문 쪽 그림을 인라인으로 넣어 20MB 를 넘는다.
# 스크립트로 언제든 다시 만든다 (verify.py · verify_req.py). 배포 산출물인
# equip-catalog.html 만 저장소에 둔다.
service-autopilot/review/spec-verify.html
service-autopilot/review/req-verify-*.html

# 벤더 문서 포털 조사 스냅샷 — Fluid Topics API 로 재조회 가능 (sources.py 주석 참고)
service-autopilot/pipeline/data/haystack/_*.json

# 임시
*.tmp
*.bak
data/tmp.json
service-autopilot/pipeline/tmp-*.png

# JCI 본문 전수 스캔 중간물 — 고정 후보 입력(_jci_scan_tiers.json)과
# 최종 근거(jci-body-scan.json)만 추적한다.
service-autopilot/pipeline/data/_jci_scan_candidates.json
service-autopilot/pipeline/data/_jci_scan_hits_*.json
service-autopilot/pipeline/data/_jci_ipu_docs.json

# 브라우저 자동화 세션 로그 (Playwright MCP) — 산출물 아님
.playwright-mcp/
